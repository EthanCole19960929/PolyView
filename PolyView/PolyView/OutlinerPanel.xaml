<UserControl x:Class="PolyView.OutlinerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF282828"
             Foreground="#FFDADADA"
             FontSize="12">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ToggleBrush" Color="#FFC8C8C8"/>
        <!-- Blender-style toggle: draws its Content (a Path); unchecked = dimmed -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArrowToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow" Data="M0,0 L4,3.5 L0,7" Stroke="#FFB0B0B0" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="Rot" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FF3D3D3D" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF545454"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="120"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*" MinHeight="140"/>
        </Grid.RowDefinitions>

        <!-- Outliner (Blender 4.2, View Layer mode) -->
        <DockPanel Grid.Row="0">
            <Border DockPanel.Dock="Top" Background="#FF282828" Padding="4,4,4,3">
                <DockPanel>
                    <!-- display mode -->
                    <Button DockPanel.Dock="Left" Style="{StaticResource HeaderButton}" x:Name="DisplayModeButton">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Fill="#FFC8C8C8"
                                  Data="M0,0 H14 V2 H0 Z M3,5 H14 V7 H3 Z M3,10 H14 V12 H3 Z M0,5 H2 V7 H0 Z M0,10 H2 V12 H0 Z"/>
                            <Path Margin="4,0,0,0" Data="M0,0 L3.5,3.5 L7,0" Stroke="#FFB0B0B0" StrokeThickness="1.3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- filter / view -->
                    <Button DockPanel.Dock="Left" Style="{StaticResource HeaderButton}" x:Name="ViewButton">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFC8C8C8" StrokeThickness="1.3"
                                  Data="M1,1 H13 V13 H1 Z M1,5 H13 M5,5 V13"/>
                            <Path Margin="4,0,0,0" Data="M0,0 L3.5,3.5 L7,0" Stroke="#FFB0B0B0" StrokeThickness="1.3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- new collection -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Margin="3,0,0,0" x:Name="NewCollectionButton" Padding="4,0">
                        <Path Width="15" Height="15" Stretch="Uniform" Stroke="#FFC8C8C8" StrokeThickness="1.2" StrokeLineJoin="Round"
                              Data="M2,4 L8,1 L14,4 L14,11 L8,14 L2,11 Z M2,4 L8,7 L14,4 M8,7 L8,14"/>
                    </Button>
                    <!-- filter dropdown -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Margin="3,0,0,0" x:Name="FilterButton">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stretch="Uniform" Fill="#FFC8C8C8" Data="M0,0 H14 L9,6 V12 L5,14 V6 Z"/>
                            <Path Margin="4,0,0,0" Data="M0,0 L3.5,3.5 L7,0" Stroke="#FFB0B0B0" StrokeThickness="1.3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- search -->
                    <Border Background="#FF1D1D1D" BorderBrush="#FF3D3D3D" BorderThickness="1" CornerRadius="11" Height="22">
                        <Grid>
                            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="#FFE6E6E6" BorderThickness="0"
                                     CaretBrush="#FFE6E6E6" VerticalContentAlignment="Center"
                                     Padding="22,0,6,0" TextChanged="SearchBox_TextChanged"/>
                            <Path Data="M4.5,0.5 A4,4 0 1 1 4.49,0.5 M7.5,7.5 L11,11" Stroke="#FFA0A0A0" StrokeThickness="1.4"
                                  StrokeEndLineCap="Round" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Foreground="#FF8A8A8A" Margin="24,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
            <ListBox x:Name="ItemList"
                     Background="#FF282828"
                     BorderThickness="0"
                     Foreground="#FFDADADA"
                     SelectionMode="Extended"
                     AlternationCount="2"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionChanged="ItemList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Height="24">
                                        <ContentPresenter VerticalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF2B2B2B"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF363636"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF4A4A4A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IndentWidth}"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <!-- vertical guide lines -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding GuideLines}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="1" Height="24" Fill="#FF4A4A4A"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ArrowToggle}"
                                          IsChecked="{Binding Expanded, Mode=TwoWay}" Visibility="{Binding ChevronVisibility}"/>
                            <Grid Grid.Column="2" Width="16" Height="16" Opacity="{Binding RowOpacity}">
                                <Path Data="{Binding IconFill}" Fill="{Binding IconBrush}" Stretch="None"/>
                                <Path Data="{Binding IconStroke}" Stroke="{Binding IconBrush}" StrokeThickness="1.2"
                                      StrokeLineJoin="Round" Stretch="None"/>
                            </Grid>
                            <TextBlock Grid.Column="3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Visibility="{Binding NameVisibility}"
                                       VerticalAlignment="Center" Margin="3,0,4,0" Opacity="{Binding RowOpacity}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFCCCCCC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Grid.Column="3" Grid.ColumnSpan="2" Visibility="{Binding EditVisibility}" Margin="1,2,4,2"
                                     Background="#FF1D1D1D" Foreground="#FFFFFFFF" BorderBrush="#FF4772B3" BorderThickness="1"
                                     CaretBrush="White" VerticalContentAlignment="Center" Padding="2,0"
                                     IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown"
                                     LostKeyboardFocus="RenameBox_LostFocus"/>
                            <Path Grid.Column="4" Data="{Binding DataIcon}" Stroke="#FF55C7A6" Fill="{Binding DataFill}" StrokeThickness="1.1"
                                  StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" Opacity="{Binding RowOpacity}"/>
                            <!-- exclude checkbox (collection only) -->
                            <ToggleButton Grid.Column="6" Style="{StaticResource IconToggle}" IsChecked="{Binding Included, Mode=TwoWay}"
                                          Visibility="{Binding CheckVisibility}" ToolTip="{Binding ExcludeTip}">
                                <Border Width="13" Height="13" CornerRadius="2" BorderThickness="1" BorderBrush="#FF707070">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FF3D3D3D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Included}" Value="True">
                                                    <Setter Property="Background" Value="#FF4772B3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Data="M2,6 L5,9 L10,3" Stroke="White" StrokeThickness="1.6" Visibility="{Binding CheckMarkVisibility}"
                                          StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                            </ToggleButton>
                            <ToggleButton Grid.Column="7" Style="{StaticResource IconToggle}" IsChecked="{Binding Visible, Mode=TwoWay}"
                                          Visibility="{Binding ToggleVisibility}" ToolTip="{Binding EyeTip}">
                                <Path Data="{Binding EyeData}" Stroke="{StaticResource ToggleBrush}" StrokeThickness="1.2"
                                      StrokeLineJoin="Round" Opacity="{Binding ToggleOpacity}"/>
                            </ToggleButton>
                            <ToggleButton Grid.Column="8" Style="{StaticResource IconToggle}" IsChecked="{Binding BoneVisible, Mode=TwoWay}"
                                          Visibility="{Binding BoneToggleVisibility}" ToolTip="{Binding BoneEyeTip}">
                                <Path Data="{Binding BoneEyeData}" Stroke="{StaticResource ToggleBrush}" StrokeThickness="1.2"
                                      StrokeLineJoin="Round" Opacity="{Binding BoneToggleOpacity}"/>
                            </ToggleButton>
                            <ToggleButton Grid.Column="9" Style="{StaticResource IconToggle}" IsChecked="{Binding Renderable, Mode=TwoWay}"
                                          Visibility="{Binding ToggleVisibility}" ToolTip="{Binding RenderTip}">
                                <Path Data="M1.5,4.5 H9.5 V11.5 H1.5 Z M9.5,7 L13.5,5 V11 L9.5,9 Z" Stroke="{StaticResource ToggleBrush}"
                                      StrokeThickness="1.2" StrokeLineJoin="Round" Opacity="{Binding RenderOpacity}"/>
                            </ToggleButton>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#FF1D1D1D" ResizeDirection="Rows"/>

        <!-- 属性 / 变换面板 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#FF2E2E2E">
            <StackPanel Margin="8,6">
                <TextBlock x:Name="TransformHeader" FontWeight="SemiBold" Foreground="#FFE6E6E6" Margin="0,0,0,4"/>
                <Grid x:Name="TransformGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LocationLabel" Grid.Row="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RotationLabel" Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScaleLabel" Grid.Row="2" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="PropertyHeader" FontWeight="SemiBold" Foreground="#FFE6E6E6" Margin="0,10,0,4"/>
                <TextBlock x:Name="PropertyText" Foreground="#FFC8C8C8" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
