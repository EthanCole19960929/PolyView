<UserControl x:Class="PolyView.OutlinerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF282828"
             Foreground="#FFDADADA">
    <UserControl.Resources>
        <Style x:Key="FlatToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFCFCFCF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF545454"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="120"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*" MinHeight="140"/>
        </Grid.RowDefinitions>

        <!-- 场景大纲 -->
        <DockPanel Grid.Row="0">
            <Border DockPanel.Dock="Top" Background="#FF3D3D3D" Padding="4,3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#FFCFCFCF" VerticalAlignment="Center" Margin="2,0,6,0" x:Name="ModeIcon"/>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#FFCFCFCF" VerticalAlignment="Center" Margin="6,0,2,0" x:Name="FilterIcon"/>
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="#FF1D1D1D" Foreground="#FFE6E6E6" BorderThickness="0"
                                 Padding="20,2,4,2" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FF9A9A9A"
                                   Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Foreground="#FF7A7A7A" Margin="22,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </Border>
            <ListBox x:Name="ItemList"
                     Background="#FF282828"
                     BorderThickness="0"
                     Foreground="#FFDADADA"
                     SelectionMode="Single"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionChanged="ItemList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Height="22">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF333333"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF334D80"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="{Binding IndentMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0" Style="{StaticResource FlatToggle}" Width="14" FontSize="8"
                                          Content="{Binding ChevronGlyph}" IsChecked="{Binding Expanded, Mode=TwoWay}"
                                          Visibility="{Binding ChevronVisibility}" Opacity="1"/>
                            <TextBlock Grid.Column="1" Text="{Binding Icon}" Foreground="{Binding IconBrush}"
                                       FontFamily="{Binding IconFont}" FontSize="12" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" IsChecked="True" Visibility="{Binding CheckVisibility}"
                                      VerticalAlignment="Center" Focusable="False"/>
                            <TextBlock Grid.Column="2" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Opacity="{Binding NameOpacity}" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFDADADA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFAF29"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="{Binding DataGlyph}" Foreground="#FF7FBF5F"
                                       FontFamily="Segoe UI Symbol" FontSize="9" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="4" Style="{StaticResource FlatToggle}"
                                          Content="{Binding EyeGlyph}" IsChecked="{Binding Visible, Mode=TwoWay}"
                                          Visibility="{Binding ToggleVisibility}" ToolTip="{Binding EyeTip}"/>
                            <ToggleButton Grid.Column="5" Style="{StaticResource FlatToggle}"
                                          Content="&#xE722;" IsChecked="{Binding Renderable, Mode=TwoWay}"
                                          Visibility="{Binding ToggleVisibility}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#FF1D1D1D" ResizeDirection="Rows"/>

        <!-- 属性 / 变换面板 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#FF2E2E2E">
            <StackPanel Margin="8,6">
                <TextBlock x:Name="TransformHeader" FontWeight="SemiBold" Foreground="#FFE6E6E6" Margin="0,0,0,4"/>
                <Grid x:Name="TransformGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LocationLabel" Grid.Row="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RotationLabel" Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScaleLabel" Grid.Row="2" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="PropertyHeader" FontWeight="SemiBold" Foreground="#FFE6E6E6" Margin="0,10,0,4"/>
                <TextBlock x:Name="PropertyText" Foreground="#FFC8C8C8" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
