<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Blender 4.2 dark menus, shared by the top bar and every ContextMenu (Shift+A etc.). -->
    <SolidColorBrush x:Key="MenuPopupBrush" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#FF4772B3"/>
    <SolidColorBrush x:Key="MenuTextBrush" Color="#FFE6E6E6"/>
    <SolidColorBrush x:Key="MenuDisabledBrush" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="MenuGestureBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="MenuHeaderBrush" Color="#FFBDBDBD"/>
    <DropShadowEffect x:Key="MenuShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.5" Color="Black"/>

    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,3" Background="{StaticResource MenuBorderBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="0,0,6,6" Background="{StaticResource MenuPopupBrush}" BorderBrush="{StaticResource MenuBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="3" MinWidth="180" Effect="{StaticResource MenuShadow}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}" MinHeight="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="IconCol" Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition x:Name="ArrowCol" Width="14"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="14" Height="14"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="Header" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                           Foreground="{StaticResource MenuGestureBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Path x:Name="Arrow" Grid.Column="3" Data="M0,0 L3.5,3.5 L0,7" Stroke="#FFB8B8B8" StrokeThickness="1.3"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Margin="0,0,6,6" Background="{StaticResource MenuPopupBrush}" BorderBrush="{StaticResource MenuBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="3" MinWidth="180" Effect="{StaticResource MenuShadow}">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter TargetName="Bd" Property="MinHeight" Value="20"/>
                            <Setter TargetName="IconCol" Property="Width" Value="0"/>
                            <Setter TargetName="ArrowCol" Property="Width" Value="0"/>
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="header">
                            <Setter Property="Foreground" Value="{StaticResource MenuHeaderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSubmenuOpen" Value="True"/>
                                <Condition Property="Role" Value="TopLevelHeader"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#FF4A4A4A"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="Tag" Value="{x:Null}"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource MenuDisabledBrush}"/>
                            <Setter TargetName="Icon" Property="Opacity" Value="0.5"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>