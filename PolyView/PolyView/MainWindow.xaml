<Window x:Class="PolyView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PolyView"
        Title="PolyView"
        Icon="pack://application:,,,/polyview.ico"
        Height="720"
        Width="1100"
        MinHeight="480"
        MinWidth="800"
        Background="#FF1D1D1D"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Blender 4.2 dark theme for the top bar menus. -->
        <SolidColorBrush x:Key="BarBrush" Color="#FF303030"/>
        <SolidColorBrush x:Key="MenuPopupBrush" Color="#FF181818"/>
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#FF4772B3"/>
        <SolidColorBrush x:Key="MenuTextBrush" Color="#FFE6E6E6"/>
        <SolidColorBrush x:Key="MenuDisabledBrush" Color="#FF6E6E6E"/>
        <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,3" Background="#FF3A3A3A"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="Header" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gesture" Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                               Foreground="#FF9A9A9A" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="{StaticResource MenuPopupBrush}" BorderBrush="#FF3D3D3D" BorderThickness="1"
                                        CornerRadius="4" Padding="3" MinWidth="180">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter Property="Padding" Value="8,3"/>
                                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter Property="Padding" Value="10,4"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MenuDisabledBrush}"/>
                                <Setter TargetName="Gesture" Property="Foreground" Value="{StaticResource MenuDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceTab" TargetType="Border">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BarBrush}" Padding="6,2" BorderBrush="#FF161616" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/polyview.ico" Width="16" Height="16" Margin="2,0,6,0" VerticalAlignment="Center"/>
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem x:Name="MenuFile">
                        <MenuItem x:Name="MenuNew" IsEnabled="False" InputGestureText="Ctrl+N"/>
                        <MenuItem x:Name="MenuOpen" InputGestureText="Ctrl+O" Click="OpenButton_Click"/>
                        <MenuItem x:Name="MenuRecent" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem x:Name="MenuSave" IsEnabled="False" InputGestureText="Ctrl+S"/>
                        <Separator/>
                        <MenuItem x:Name="MenuImport" IsEnabled="False"/>
                        <MenuItem x:Name="MenuExport" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem x:Name="MenuQuit" InputGestureText="Ctrl+Q" Click="MenuQuit_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuEdit">
                        <MenuItem x:Name="MenuUndo" InputGestureText="Ctrl+Z" Click="MenuUndo_Click"/>
                        <MenuItem x:Name="MenuRedo" InputGestureText="Ctrl+Shift+Z" Click="MenuRedo_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuResetView" Click="ResetButton_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuLanguage" Click="LanguageButton_Click"/>
                        <MenuItem x:Name="MenuPreferences" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuRender">
                        <MenuItem x:Name="MenuRenderImage" IsEnabled="False" InputGestureText="F12"/>
                        <MenuItem x:Name="MenuRenderAnimation" IsEnabled="False" InputGestureText="Ctrl+F12"/>
                        <Separator/>
                        <MenuItem x:Name="MenuViewRender" IsEnabled="False" InputGestureText="F11"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuWindow">
                        <MenuItem x:Name="MenuNewWindow" IsEnabled="False"/>
                        <MenuItem x:Name="MenuFullscreen" InputGestureText="Ctrl+Alt+Space" Click="MenuFullscreen_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuProjection" InputGestureText="Numpad 5" Click="MenuProjection_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuHelp">
                        <MenuItem x:Name="MenuManual" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem x:Name="MenuAbout" Click="MenuAbout_Click"/>
                    </MenuItem>
                </Menu>
                <StackPanel x:Name="WorkspaceTabs" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarBrush}" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#FFB5B5B5" Margin="16,0,0,0"/>
                <TextBlock x:Name="HintText" Foreground="#FF8C8C8C" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <local:OutlinerPanel x:Name="Outliner" DockPanel.Dock="Right" Width="300"/>
        <Grid>
            <local:ModelViewport x:Name="Viewport"/>
            <TextBlock x:Name="ProjectionText" Foreground="#FFE6E6E6" Margin="52,8,0,0" FontSize="12"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</Window>
