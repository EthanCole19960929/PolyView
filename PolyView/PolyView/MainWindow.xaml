<Window x:Class="PolyView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PolyView"
        Title="PolyView"
        Icon="pack://application:,,,/polyview.ico"
        Height="720"
        Width="1100"
        MinHeight="480"
        MinWidth="800"
        Background="#FF1D1D1D"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Blender 4.2 dark theme for the top bar menus. -->
        <SolidColorBrush x:Key="BarBrush" Color="#FF303030"/>
        <Style x:Key="WorkspaceTab" TargetType="Border">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BarBrush}" Padding="6,2" BorderBrush="#FF161616" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem x:Name="MenuFile">
                        <MenuItem x:Name="MenuOpen" InputGestureText="Ctrl+O" Click="OpenButton_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuSave" IsEnabled="False" InputGestureText="Ctrl+S"/>
                        <Separator/>
                        <MenuItem x:Name="MenuImport" IsEnabled="False"/>
                        <MenuItem x:Name="MenuExport" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem x:Name="MenuQuit" InputGestureText="Ctrl+Q" Click="MenuQuit_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuEdit">
                        <MenuItem x:Name="MenuUndo" InputGestureText="Ctrl+Z" Click="MenuUndo_Click"/>
                        <MenuItem x:Name="MenuRedo" InputGestureText="Ctrl+Shift+Z" Click="MenuRedo_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuResetView" Click="ResetButton_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuPreferences"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuWindow">
                        <MenuItem x:Name="MenuFullscreen" InputGestureText="Ctrl+Alt+Space" Click="MenuFullscreen_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuProjection" InputGestureText="Numpad 5" Click="MenuProjection_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuHelp">
                        <MenuItem x:Name="MenuAbout" Click="MenuAbout_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuMcp"/>
                </Menu>
                <StackPanel x:Name="WorkspaceTabs" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarBrush}" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#FFB5B5B5" Margin="16,0,0,0"/>
                <TextBlock x:Name="HintText" Foreground="#FF8C8C8C" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="220"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <local:ModelViewport x:Name="Viewport"/>
                <TextBlock x:Name="ProjectionText" Foreground="#FFE6E6E6" Margin="50,38,0,0" FontSize="12"
                           HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#FF1D1D1D"
                          Cursor="SizeWE" ShowsPreview="True" ToolTip="拖动以调整视口与侧栏宽度 / Drag to resize viewport and sidebar"/>
            <TabControl x:Name="SideTabs" Grid.Column="2" Background="#FF282828" Foreground="#FFE6E6E6" BorderThickness="0">
                <TabItem x:Name="SceneTab" Background="#FF303030" Foreground="#FFE6E6E6" Padding="10,4">
                    <Grid Background="#FF282828">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="1.4*" MinHeight="160"/>
                        </Grid.RowDefinitions>
                        <local:OutlinerPanel x:Name="Outliner" Grid.Row="0"/>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#FF1D1D1D" ResizeDirection="Rows"/>
                        <local:PropertiesEditor x:Name="Properties" Grid.Row="2"/>
                    </Grid>
                </TabItem>
                <TabItem x:Name="AnimationTab" Background="#FF303030" Foreground="#FFE6E6E6" Padding="10,4">
                    <local:AnimationPanel x:Name="Animations"/>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
