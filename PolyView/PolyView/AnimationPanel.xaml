<UserControl x:Class="PolyView.AnimationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#282828" Foreground="#E6E6E6">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#404040"/><Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#555555"/><Setter Property="Padding" Value="9,2"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="7,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,5">
            <TextBlock x:Name="Heading" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Background="#1D1D1D" Foreground="#E6E6E6"
                         BorderBrush="#454545" Padding="5,3" TextChanged="Search_TextChanged"/>
                <TextBlock x:Name="SearchHint" Foreground="#888888" Margin="6,3" IsHitTestVisible="False"/>
            </Grid>
            <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" Padding="8,2" Margin="5,0,0,0"
                    Background="#404040" Foreground="#E6E6E6" BorderBrush="#555555"/>
        </Grid>
        <WrapPanel Grid.Row="2" Margin="0,0,0,3" VerticalAlignment="Center">
            <Button x:Name="PlayButton" Click="Play_Click" Margin="0,0,4,0" MinWidth="55"/>
            <Button x:Name="StopButton" Click="Stop_Click" Margin="0,0,6,0"/>
            <CheckBox x:Name="LoopCheck" IsChecked="True" Checked="Loop_Changed" Unchecked="Loop_Changed" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="SpeedBox" SelectedIndex="2" SelectionChanged="Speed_Changed" Width="58" Margin="0,0,0,0">
                <ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/>
                <ComboBoxItem Content="1.5×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/>
            </ComboBox>
        </WrapPanel>
        <Grid Grid.Row="3" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="Timeline" Minimum="0" Maximum="1" ValueChanged="Timeline_Changed" VerticalAlignment="Center" ToolTip="拖动时间轴预览 / Drag to seek"/>
            <TextBlock x:Name="PlaybackTime" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="88" TextAlignment="Right"/>
        </Grid>
        <Grid Grid.Row="4">
            <DataGrid x:Name="ClipList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="23"
                      Background="#242424" Foreground="#E6E6E6" RowBackground="#292929" AlternatingRowBackground="#303030"
                      BorderBrush="#414141" SelectionMode="Single" EnableRowVirtualization="True"
                      SelectionChanged="Clip_Changed" MouseDoubleClick="Clip_DoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#383838"/><Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="Padding" Value="6,3"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#242424"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,1"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn x:Name="DurationColumn" Binding="{Binding DurationText}" Width="62"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAAAAA" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock x:Name="ScanStatus" Grid.Row="5" FontSize="11" Foreground="#AAAAAA" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
